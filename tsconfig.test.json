{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "out-test",
    "module": "commonjs",
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/liveRefresh.ts",
    "src/sqlSafety.ts",
    "src/sortOrder.ts",
    "src/duckdbConnection.ts",
    "src/kdbParser.ts",
    "src/xlsxSheets.ts",
    "src/chartSpec.ts",
    "src/xlsxWrite.ts",
    // Pulls in chartPanel.ts too, and both import `vscode`. That resolves for
    // TYPES via @types/vscode; at runtime it is satisfied by
    // test/stress/stubs/vscode.ts, which patches Module._load and must be
    // imported before anything that reaches these.
    "src/duckdbEditorProvider.ts",
    "test/**/*.ts"
  ]
}
